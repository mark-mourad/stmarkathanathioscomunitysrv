# App (already in your .env)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Set this same key in Lovable Cloud environment variables for server-side admin operations

# Supabase CLI — required for `npm run supabase:push`
# 1) Create token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN="your_access_token_here"
SUPABASE_DB_PASSWORD="your_db_password_here"